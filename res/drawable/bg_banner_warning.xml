<?xml version="1.0" encoding="utf-8"?>
<!--
  Digital Retreat notice banner: solid clay fill, generous rounded corners and
  a thick contrasting stroke so the banner is the first thing the eye lands on
  at the top of the onboarding screen — calm, but impossible to miss.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/banner_bg" />
    <corners android:radius="16dp" />
    <stroke android:width="2dp" android:color="@color/banner_stroke" />
</shape>
