<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================================
   Screen Time Locker — initial onboarding layout
  ============================================================================

  Layout contract (top-to-bottom):
    [1] A highly visible WARNING BANNER pinned to the very top. Its message is
        rendered verbatim from @string/onboarding_warning_banner and is the
        loudest element on the screen.
    [2] A scrolling content column beneath it, whose centrepiece is the
        permission-steps CONTAINER (@id/permissionStepsContainer). The container
        is an empty, ready placeholder: the Activity injects one row per upcoming
        permission step at runtime.

  Responsiveness: the root is a fillViewport ScrollView over a single vertical
  LinearLayout that spans the viewport width. Every block is match_parent or
  wrap_content with dp spacing and SP typography, so it reflows cleanly across
  portrait, landscape, small phones and tablets without a second layout.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboardingScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:id="@+id/onboardingContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- ============================ [1] WARNING BANNER ============================
             Prominent, first element on the screen. Danger-filled surface with a
             thick stroke and elevation lift. The message is a single TextView so
             the required sentence is never fragmented. -->
        <LinearLayout
            android:id="@+id/warningBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_banner_warning"
            android:elevation="6dp"
            android:padding="18dp"
            android:contentDescription="@string/onboarding_warning_banner">

            <TextView
                android:id="@+id/warningBannerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_warning_banner"
                android:textColor="@color/banner_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp"
                android:gravity="start" />
        </LinearLayout>

        <!-- ============================ screen title ============================ -->
        <TextView
            android:id="@+id/onboardingTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/onboarding_title"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- ============================ steps section header ============================ -->
        <TextView
            android:id="@+id/stepsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/onboarding_steps_title"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <!-- ============================ [2] PERMISSION-STEPS CONTAINER ============================
             Empty, ready placeholder. The Activity adds one step view per
             permission here. The placeholder TextView is the initial child and
             is removed once real steps are injected. -->
        <LinearLayout
            android:id="@+id/permissionStepsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/bg_step_card"
            android:minHeight="96dp"
            android:padding="16dp">

            <TextView
                android:id="@+id/permissionStepsPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_steps_placeholder"
                android:textColor="@color/text_faint"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- ============================ primary action ============================ -->
        <Button
            android:id="@+id/btnContinue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_primary_button"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:text="@string/onboarding_continue"
            android:textAllCaps="false"
            android:textColor="@color/accent_text"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
