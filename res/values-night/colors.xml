<?xml version="1.0" encoding="utf-8"?>
<!--
  Digital Retreat design tokens (DARK "nightfall" counterpart). Applied
  automatically when the system is in night mode. Same token names, same
  evergreen accent family and contrast as the light set, so the onboarding
  screen reads identically in either theme.
-->
<resources>
    <!-- window / surfaces -->
    <color name="screen_bg">#121A16</color>
    <color name="surface">#1B2620</color>
    <color name="surface_alt">#24322A</color>
    <color name="border">#33453B</color>

    <!-- text -->
    <color name="text_primary">#EEF3EC</color>
    <color name="text_secondary">#B4C2B7</color>
    <color name="text_faint">#86948A</color>

    <!-- accent (primary action) -->
    <color name="accent">#7FC8A9</color>
    <color name="accent_text">#0E241C</color>

    <!-- notice banner: deep clay fill + warm text so it stays the loudest
         element on a dark screen without glare. -->
    <color name="banner_bg">#6E2A1E</color>
    <color name="banner_text">#FBD9C8</color>
    <color name="banner_stroke">#8A3A24</color>
</resources>
