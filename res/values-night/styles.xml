<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DARK "nightfall" counterpart of AppTheme, applied automatically when the
         system is in night mode. Keeps the same evergreen accent family and
         contrast as the light set so the console reads identically in either
         theme. LockTheme is intentionally not overridden here (the retreat lock
         surface is always dark). -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowBackground">#121A16</item>
        <item name="android:colorBackground">#121A16</item>
        <item name="android:textColorPrimary">#EEF3EC</item>
        <item name="android:textColorSecondary">#B4C2B7</item>
        <item name="android:textColorHint">#86948A</item>
        <item name="android:colorAccent">#7FC8A9</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
