<?xml version="1.0" encoding="utf-8"?>
<!--
  Digital Retreat design tokens (LIGHT "daylight" palette).

  Warm paper, deep-forest ink and a calm evergreen accent. These mirror the
  values in Ui.java so the XML onboarding screen reads with exactly the same
  colours as the programmatically-drawn console. A values-night override
  supplies the balanced dark "nightfall" counterpart.
-->
<resources>
    <!-- window / surfaces -->
    <color name="screen_bg">#F4F1EA</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_alt">#EDE8DE</color>
    <color name="border">#DAD3C4</color>

    <!-- text -->
    <color name="text_primary">#1E2A24</color>
    <color name="text_secondary">#4C5B52</color>
    <color name="text_faint">#86948A</color>

    <!-- accent (primary action) -->
    <color name="accent">#2F6F5E</color>
    <color name="accent_text">#FFFFFF</color>

    <!-- notice banner (high-contrast clay surface) -->
    <color name="banner_bg">#C0563A</color>
    <color name="banner_text">#FFFFFF</color>
    <color name="banner_stroke">#8A3A24</color>
</resources>
