<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Default (LIGHT "daylight") theme for the retreat console. The window
         surfaces match the Ui palette so there is no flash of the wrong colour
         before the first draw. A values-night override supplies the balanced
         dark "nightfall" counterpart. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowBackground">#F4F1EA</item>
        <item name="android:colorBackground">#F4F1EA</item>
        <item name="android:textColorPrimary">#1E2A24</item>
        <item name="android:textColorSecondary">#4C5B52</item>
        <item name="android:textColorHint">#86948A</item>
        <item name="android:colorAccent">#2F6F5E</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Sanctuary theme: always dark, opaque, no action bar, no wallpaper. This
         is the full-screen retreat lock surface, so it intentionally does not
         follow the system light/dark setting. -->
    <style name="LockTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#0C1410</item>
        <item name="android:colorBackground">#0C1410</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:textColorPrimary">#F3F7F1</item>
        <item name="android:colorAccent">#7FC8A9</item>
    </style>
</resources>
